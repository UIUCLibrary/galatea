import QmlProject

Project {
    mainFile: "src/galatea/gui/qml/Editor/App.qml"
    mainUiFile: "src/galatea/gui/qml/Editor/Screen01.ui.qml"


    /* Include .qml, .js, and image files from current directory and subdirectories */
    QmlFiles {
        directory: "src/galatea/gui/qml/Editor"
    }
    importPaths: ["src/galatea/gui/qml"]


    JavaScriptFiles {
        directory: "src/galatea/gui/qml/Editor"
    }

    Files {
        files: ["qtquickcontrols2.conf"]
    }

    // Files {
    //     filter: "qmldir"
    //     directory: "."
    // }

    // FontFiles {
    //     filter: "*.ttf;*.otf"
    // }

    // Files {
    //     filter: "*.wav;*.mp3"
    // }

    // Files {
    //     filter: "*.mp4"
    // }

    // Files {
    //     filter: "*.glsl;*.glslv;*.glslf;*.vsh;*.fsh;*.vert;*.frag"
    // }

    // Files {
    //     filter: "*.qsb"
    // }

    // Files {
    //     filter: "*.json"
    // }

    // Files {
    //     filter: "*.mesh"
    //     directory: "Generated"
    // }

    // Files {
    //     filter: "*.qad"
    //     directory: "Generated"
    // }

    // /* Baked lightmaps */
    // Files {
    //     filter: "*.bin;*.exr;*.mesh"
    //     directory: "EditorContent"
    // }

    Environment {
        QT_QUICK_CONTROLS_CONF: "qtquickcontrols2.conf"
        QML_COMPAT_RESOLVE_URLS_ON_ASSIGNMENT: "1"
        QT_LOGGING_RULES: "qt.qml.connections=false"
        QT_ENABLE_HIGHDPI_SCALING: "0"
        /* Useful for debugging
       QSG_VISUALIZE=batches
       QSG_VISUALIZE=clip
       QSG_VISUALIZE=changes
       QSG_VISUALIZE=overdraw
       */
    }

    qt6Project: true

    qdsVersion: "4.8"

    quickVersion: "6.9"

    multilanguageSupport: true
    supportedLanguages: ["en"]
    primaryLanguage: "en"

}
